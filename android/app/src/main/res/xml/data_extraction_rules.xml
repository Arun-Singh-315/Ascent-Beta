<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Controls what is backed up to Google Drive (cloud backup)
    and what is transferred during device-to-device transfer.
    
    For Ascent, both cloud backup and device transfer should
    include all user data (database + resumes + preferences).
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- drift_flutter stores the workspace under app_flutter, not databases/. -->
        <include domain="root" path="app_flutter/" />
        <include domain="file" path="resumes" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- drift_flutter stores the workspace under app_flutter, not databases/. -->
        <include domain="root" path="app_flutter/" />
        <include domain="file" path="resumes" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
